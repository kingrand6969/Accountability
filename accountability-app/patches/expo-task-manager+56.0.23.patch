+  private boolean isGenerationTask(TaskInterface task) {
+    return task != null && task.getOptions() != null && task.getOptions().containsKey(GENERATION_TASK_OPTION);
+  }
+
+  private boolean notifyGenerationTaskFailure(TaskInterface task, String message) {
+    if (!isGenerationTask(task)) {
+      return false;
+    }
+    try {
+      task.getConsumer()
+        .getClass()
+        .getMethod("didFailToLoadTaskApp", String.class)
