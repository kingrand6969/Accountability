+- (BOOL)_isGenerationTask:(id<EXTaskInterface>)task
+{
+  return task != nil && task.options[EXGenerationTaskOption] != nil;
+}
+
+- (BOOL)_notifyGenerationTaskFailure:(id<EXTaskInterface>)task message:(NSString *)message
+{
+  if (![self _isGenerationTask:task]) {
+    return NO;
+  }
+  SEL selector = NSSelectorFromString(@"didFailToLoadTaskApp:");
+  if (![task.consumer respondsToSelector:selector]) {
+    NSLog(@"EXTaskService: Generation task cannot be fail-stopped; preserving its durable registration.");
+    return NO;
+  }
+  typedef void (*GenerationFailureImplementation)(id, SEL, NSString *);
+  GenerationFailureImplementation implementation = (GenerationFailureImplementation)[task.consumer methodForSelector:selector];
+  implementation(task.consumer, selector, message);
+  return YES;
+}
+
+- (BOOL)_failGenerationTask:(id<EXTaskInterface>)task
+                    eventId:(NSString *)eventId
+                    message:(NSString *)message
+{
+  NSMutableArray<NSString *> *appEvents = _events[task.appId];
+  if (eventId != nil && (appEvents == nil || ![appEvents containsObject:eventId])) {
+    return NO;
+  }
+  if (![self _notifyGenerationTaskFailure:task message:message]) {
+    return NO;
+  }
+  if (eventId != nil) {
+    [appEvents removeObject:eventId];
+    [_eventTasks removeObjectForKey:eventId];
+    if ([task.consumer respondsToSelector:@selector(didFinish)]) {
+      [task.consumer didFinish];
+    }
+    for (EXTaskExecutionRequest *request in [_requests copy]) {
+      if ([request isIncludingTask:task]) {
+        [request task:task didFinishWithResult:@(UIBackgroundFetchResultFailed)];
+      }
+    }
+    if (appEvents.count == 0) {
+      [_events removeObjectForKey:task.appId];
+    }
+  }
+  return YES;
+}
+
+- (void)_scheduleGenerationTaskWatchdog:(id<EXTaskInterface>)task eventId:(NSString *)eventId
+{
+  if (![self _isGenerationTask:task]) {
+    return;
+  }
+  dispatch_after(
+    dispatch_time(DISPATCH_TIME_NOW, (int64_t)(EXGenerationTaskExecutionTimeout * NSEC_PER_SEC)),
+    dispatch_get_main_queue(),
+    ^{
+      [self _failGenerationTask:task
+                        eventId:eventId
+                        message:@"Generation task completion timed out before durable JavaScript acknowledgement"];
+    }
+  );
+}
+
+- (void)_failAllEventsForAppLoad:(NSString *)appId
+{
+  NSArray<NSString *> *eventIds = [_events[appId] copy] ?: @[];
+  for (NSString *eventId in eventIds) {
+    id<EXTaskInterface> task = _eventTasks[eventId];
+    if ([self _isGenerationTask:task]) {
+      [self _failGenerationTask:task
+                        eventId:eventId
+                        message:@"Headless app loader failed before durable JavaScript acknowledgement"];
+    } else {
+      NSMutableArray *appEvents = _events[appId];
+      [appEvents removeObject:eventId];
+      [_eventTasks removeObjectForKey:eventId];
+      if ([task.consumer respondsToSelector:@selector(didFinish)]) {
+        [task.consumer didFinish];
+      }
+    }
+  }
+  if (_events[appId].count == 0) {
+    [_events removeObjectForKey:appId];
+  }
+  [_eventsQueues removeObjectForKey:appId];
+
+  BOOL hasGenerationTask = NO;
+  for (id<EXTaskInterface> task in [self _getTasksForAppId:appId].allValues) {
+    if ([self _isGenerationTask:task]) {
+      hasGenerationTask = YES;
+      break;
+    }
+  }
+  if (!hasGenerationTask) {
+    [self unregisterAllTasksForAppId:appId];
+  } else {
+    NSLog(@"EXTaskService: Preserving durably registered generation task after app-loader failure.");
+  }
+}
