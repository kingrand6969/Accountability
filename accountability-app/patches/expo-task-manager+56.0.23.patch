+      return true;
+    } catch (Exception exception) {
+      Log.e(TAG, "Generation task could not be fail-stopped; preserving its durable registration", exception);
+      return false;
+    }
+  }
+
+  private boolean failGenerationTaskExecution(TaskInterface task, @Nullable String eventId, String message) {
+    if (!isGenerationTask(task)) {
+      return false;
+    }
+    if (eventId != null) {
+      List<String> appEvents = sEvents.get(task.getAppScopeKey());
+      if (appEvents == null || !appEvents.contains(eventId)) {
+        return false;
+      }
+    }
+    if (!notifyGenerationTaskFailure(task, message)) {
+      return false;
+    }
+    if (eventId != null) {
+      finishFailedEvent(task.getAppScopeKey(), eventId);
+    }
+    return true;
+  }
+
+  private void scheduleGenerationTaskWatchdog(TaskInterface task, String appScopeKey, String eventId) {
+    if (!isGenerationTask(task)) {
+      return;
+    }
+    new Handler(Looper.getMainLooper()).postDelayed(
+      () -> failGenerationTaskExecution(
+        task,
+        eventId,
+        "Generation task completion timed out before durable JavaScript acknowledgement"
+      ),
+      GENERATION_TASK_EXECUTION_TIMEOUT_MS
+    );
+  }
+
+  private void finishFailedEvent(String appScopeKey, String eventId) {
+    List<String> appEvents = sEvents.get(appScopeKey);
+    if (appEvents == null || !appEvents.remove(eventId)) {
+      return;
+    }
+    TaskExecutionCallback callback = sTaskCallbacks.remove(eventId);
+    sEventTasks.remove(eventId);
+    if (appEvents.isEmpty()) {
+      sEvents.remove(appScopeKey);
+      maybeFinishHeadlessTask(appScopeKey);
+    }
+    if (callback != null) {
+      callback.onFinished(null);
+    }
+  }
+
+  private void failAllEventsForAppLoad(String appScopeKey) {
+    List<String> registeredEventIds = sEvents.get(appScopeKey);
+    List<String> eventIds = registeredEventIds == null
+      ? new ArrayList<>()
+      : new ArrayList<>(registeredEventIds);
+    for (Map.Entry<String, TaskInterface> entry : new ArrayList<>(sEventTasks.entrySet())) {
+      if (appScopeKey.equals(entry.getValue().getAppScopeKey()) && !eventIds.contains(entry.getKey())) {
+        eventIds.add(entry.getKey());
+      }
+    }
+
+    for (String eventId : eventIds) {
+      TaskInterface eventTask = sEventTasks.get(eventId);
+      if (isGenerationTask(eventTask)) {
+        failGenerationTaskExecution(
+          eventTask,
+          eventId,
+          "Headless app loader failed before durable JavaScript acknowledgement"
+        );
+      } else {
+        finishFailedEvent(appScopeKey, eventId);
+      }
+    }
+    mTasksAndEventsRepository.removeEvents(appScopeKey);
+
+    Map<String, TaskInterface> appTasks = mTasksAndEventsRepository.getTasks(appScopeKey);
+    boolean hasGenerationTask = false;
+    if (appTasks != null) {
+      for (TaskInterface appTask : appTasks.values()) {
+        if (isGenerationTask(appTask)) {
+          hasGenerationTask = true;
+          break;
+        }
+      }
+    }
+    if (!hasGenerationTask) {
+      unregisterAllTasksForAppScopeKey(appScopeKey);
+    } else {
+      Log.w(TAG, "Preserving durably registered generation task after app-loader failure");
+    }
+  }
+
