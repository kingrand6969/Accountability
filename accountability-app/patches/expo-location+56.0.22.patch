+    return [self collectorError:@"Location collector generation has already been drained"];
+  }
+  if (!_collectorRecoveredInactive) {
+    return [self collectorError:@"Location collector start has already been activated"];
+  }
+  _collectorRecoveredInactive = NO;
+  _collectorStartAuthorized = YES;
+  _collectorAcceptingEvents = YES;
+  if (![self persistCollectorPhase:EXLocationCollectorPhaseStarting]) {
+    _collectorFailure = [self collectorError:@"Location collector start phase could not be persisted"];
+    return _collectorFailure;
+  }
+
+  _locationManager.delegate = self;
+  _locationManager.allowsBackgroundLocationUpdates = YES;
+  [self setOptions:_task.options];
+  _collectorSourceActivated = YES;
+  if (![self persistCollectorPhase:EXLocationCollectorPhaseStarted]) {
+    _collectorFailure = [self collectorError:@"Location collector active phase could not be persisted"];
+    [_locationManager stopUpdatingLocation];
+    [_locationManager stopMonitoringSignificantLocationChanges];
+    _locationManager.delegate = nil;
+    return _collectorFailure;
+  }
+  [self replayPersistedCollectorBatches];
+  return nil;
+}
+
+- (BOOL)persistCollectorBatches:(NSArray<NSDictionary *> *)batches
+                 throughSequence:(long long)throughSequence
+{
+  id<EXTaskInterface> task = _task;
+  if (task == nil || _collectorGeneration == nil) {
+    return NO;
+  }
+  NSDictionary *existing = [self collectorOutboxForTask:task generation:_collectorGeneration];
+  if (existing == nil) {
+    return NO;
+  }
+  NSString *existingTerminalFailure = existing[EXLocationCollectorOutboxTerminalFailure];
+  if (existingTerminalFailure != nil) {
+    _collectorTerminalFailure = [self collectorError:existingTerminalFailure];
+    return NO;
+  }
+  NSMutableDictionary *outbox = [existing mutableCopy];
+  NSMutableDictionary *pending = [outbox[EXLocationCollectorOutboxPending] mutableCopy] ?: [NSMutableDictionary new];
+  NSString *terminalMessage = nil;
+  for (NSDictionary *entry in batches) {
+    NSString *batchId = entry[@"batchId"];
+    NSDictionary *batch = entry[@"batch"];
+    if (![batchId isKindOfClass:[NSString class]] || ![batch isKindOfClass:[NSDictionary class]]) {
+      terminalMessage = @"Location collector produced an invalid durable batch";
+      break;
+    }
+    if (pending[batchId] != nil && ![pending[batchId] isEqual:batch]) {
+      terminalMessage = @"Location collector batch ID was reused";
+      break;
+    }
+    pending[batchId] = batch;
+  }
+  if (terminalMessage == nil && pending.count > EXLocationCollectorMaxPendingBatches) {
+    terminalMessage = @"Location collector pending outbox exceeds its durable batch budget";
+  }
+  NSUInteger pendingEncodedBytes = 0;
+  if (terminalMessage == nil) {
+    for (id batchValue in pending.allValues) {
+      if (![batchValue isKindOfClass:[NSDictionary class]]) {
+        terminalMessage = @"Location collector pending outbox is corrupt";
+        break;
+      }
+      NSDictionary *batch = batchValue;
+      NSError *encodingError = nil;
+      NSData *encoded = [NSPropertyListSerialization dataWithPropertyList:batch
+                                                                   format:NSPropertyListBinaryFormat_v1_0
+                                                                  options:0
+                                                                    error:&encodingError];
+      if (encoded == nil || encodingError != nil || encoded.length > EXLocationCollectorMaxEncodedBatchBytes) {
+        terminalMessage = @"Location collector batch exceeds the durable bridge limit";
+        break;
+      }
+      if (encoded.length > EXLocationCollectorMaxPendingEncodedBytes - pendingEncodedBytes) {
+        terminalMessage = @"Location collector pending outbox exceeds its durable byte budget";
+        break;
+      }
+      pendingEncodedBytes += encoded.length;
+    }
+  }
+  if (terminalMessage != nil) {
+    if (![self persistTerminalFailureMessage:terminalMessage
+                                 usingOutbox:existing
+                                        task:task
+                                  generation:_collectorGeneration]) {
+      _collectorFailure = [self collectorError:@"Location collector terminal failure could not be persisted"];
+    }
+    return NO;
+  }
+  outbox[EXLocationCollectorOutboxSequence] = @(throughSequence);
+  outbox[EXLocationCollectorOutboxPending] = pending;
+  if ([self persistCollectorOutbox:outbox task:task generation:_collectorGeneration]) {
+    return YES;
+  }
+  if (![self persistTerminalFailureMessage:@"Location collector batches could not be durably persisted"
+                               usingOutbox:existing
+                                      task:task
+                                generation:_collectorGeneration]) {
+    _collectorFailure = [self collectorError:@"Location collector terminal failure could not be persisted"];
+  }
+  return NO;
+}
+
+- (void)dispatchPersistedCollectorBatch:(NSDictionary *)batch batchId:(NSString *)batchId
+{
+  if (_collectorFailure != nil || _collectorDispatchedBatchIds.count != 0) {
+    return;
+  }
+  id<EXTaskInterface> task = _task;
+  if (task == nil) {
+    _collectorFailure = [self collectorError:@"Location task is unavailable"];
+    [self maybeCompleteCollectorDrain];
+    return;
+  }
+  [_collectorDispatchedBatchIds addObject:batchId];
+  [task executeWithData:batch withError:nil];
+}
+
+- (void)replayPersistedCollectorBatches
+{
+  if (_collectorGeneration == nil || _collectorFailure != nil || _collectorDispatchedBatchIds.count != 0) {
+    return;
+  }
+  id<EXTaskInterface> task = _task;
+  if (task == nil) {
+    _collectorFailure = [self collectorError:@"Location task is unavailable"];
+    [self maybeCompleteCollectorDrain];
+    return;
+  }
+  NSDictionary *outbox = [self collectorOutboxForTask:task generation:_collectorGeneration];
+  NSDictionary *pending = outbox[EXLocationCollectorOutboxPending];
+  if (outbox == nil || ![pending isKindOfClass:[NSDictionary class]]) {
+    _collectorFailure = [self collectorError:@"Location collector outbox is corrupt"];
+    [self maybeCompleteCollectorDrain];
+    return;
+  }
+  NSString *batchId = [[pending.allKeys sortedArrayUsingSelector:@selector(compare:)] firstObject];
+  if (batchId == nil) {
+    [self maybeCompleteCollectorDrain];
+    return;
+  }
+  NSDictionary *batch = pending[batchId];
+  if (![batch isKindOfClass:[NSDictionary class]] || ![batch[@"collectorBatchId"] isEqual:batchId]) {
+    _collectorFailure = [self collectorError:@"Persisted location collector batch is corrupt"];
+    [self maybeCompleteCollectorDrain];
+    return;
+  }
+  [self dispatchPersistedCollectorBatch:batch batchId:batchId];
+}
+
+- (BOOL)hasPendingCollectorBatches
+{
+  if (_task == nil || _collectorGeneration == nil) {
+    return YES;
+  }
+  NSDictionary *outbox = [self collectorOutboxForTask:_task generation:_collectorGeneration];
+  NSDictionary *pending = outbox[EXLocationCollectorOutboxPending];
+  if (outbox == nil || ![pending isKindOfClass:[NSDictionary class]]) {
+    _collectorFailure = [self collectorError:@"Location collector outbox is corrupt"];
+    return YES;
+  }
+  return pending.count > 0;
+}
+
+- (void)acknowledgeGeneration:(NSNumber *)generation
+                      batchId:(NSString *)batchId
+              throughSequence:(NSNumber *)throughSequence
+              taintGeneration:(BOOL)taintGeneration
+                   completion:(void (^)(NSError * _Nullable))completion
+{
+  if (![_collectorGeneration isEqualToNumber:generation]) {
+    completion([self collectorError:@"Location collector generation does not match"]);
+    return;
+  }
+  id<EXTaskInterface> task = _task;
+  if (task == nil) {
+    completion([self collectorError:@"Location task is unavailable"]);
+    return;
+  }
+  NSNumber *proof = [EXLocationTaskConsumer persistedDrainProofForTaskName:task.name
+                                                                  generation:generation];
+  if (proof != nil) {
+    NSNumber *tainted = [EXLocationTaskConsumer persistedDrainProofTaintedForTaskName:task.name
+                                                                           generation:generation];
+    completion(throughSequence.longLongValue <= proof.longLongValue &&
+      (!taintGeneration || tainted.boolValue)
+      ? nil
+      : [self collectorError:@"Location collector acknowledgement exceeds its drain proof"]);
+    return;
+  }
+  NSDictionary *existing = [self collectorOutboxForTask:task generation:generation];
+  if (existing == nil) {
+    completion([self collectorError:@"Location collector outbox is corrupt"]);
+    return;
+  }
+  NSMutableDictionary *outbox = [existing mutableCopy];
+  NSMutableDictionary *pending = [outbox[EXLocationCollectorOutboxPending] mutableCopy] ?: [NSMutableDictionary new];
+  NSNumber *acknowledgedThrough = outbox[EXLocationCollectorOutboxAcknowledgedThrough] ?: @0;
+  if (!EXLocationCollectorIsSafeInteger(acknowledgedThrough, YES) ||
+      acknowledgedThrough.longLongValue > _collectorSequence) {
+    completion([self collectorError:@"Location collector acknowledgement high-water is corrupt"]);
+    return;
+  }
+  NSDictionary *batch = pending[batchId];
+  if (batch == nil) {
+    completion(throughSequence.longLongValue <= acknowledgedThrough.longLongValue &&
+      (!taintGeneration || outbox[EXLocationCollectorOutboxTerminalFailure] != nil)
+      ? nil
+      : [self collectorError:@"Location collector batch is not pending"]);
+    return;
+  }
+  if (![batch isKindOfClass:[NSDictionary class]] ||
+      ![batch[@"collectorGeneration"] isEqual:generation] ||
+      ![batch[@"collectorBatchId"] isEqual:batchId] ||
+      ![batch[@"collectorThroughSequence"] isEqual:throughSequence]) {
+    completion([self collectorError:@"Location collector acknowledgement does not match its batch"]);
+    return;
+  }
+  [pending removeObjectForKey:batchId];
+  outbox[EXLocationCollectorOutboxPending] = pending;
+  outbox[EXLocationCollectorOutboxAcknowledgedThrough] = @(
+    MAX(acknowledgedThrough.longLongValue, throughSequence.longLongValue)
+  );
+  if (taintGeneration) {
+    outbox[EXLocationCollectorOutboxTerminalFailure] = EXLocationCollectorJavaScriptDiscardMessage;
+  }
+  if (![self persistCollectorOutbox:outbox task:task generation:generation]) {
+    completion([self collectorError:@"Location collector acknowledgement could not be persisted"]);
+    return;
+  }
+  if (taintGeneration) {
+    _collectorTerminalFailure = [self collectorError:EXLocationCollectorJavaScriptDiscardMessage];
+    [self failStopCollectorSource];
+  }
+  [self maybeCompleteCollectorDrain];
+  completion(nil);
+}
+
+- (nullable NSDictionary *)collectorOutboxForTask:(id<EXTaskInterface>)task
+                                        generation:(NSNumber *)generation
+{
+  NSUserDefaults *defaults = [NSUserDefaults standardUserDefaults];
+  id stored = [defaults objectForKey:[EXLocationTaskConsumer outboxKeyForAppId:task.appId
+                                                                      taskName:task.name
+                                                                    generation:generation]];
+  if (stored == nil) {
+    return @{
+      EXLocationCollectorOutboxSequence: @0,
+      EXLocationCollectorOutboxPending: @{},
+      EXLocationCollectorOutboxAcknowledgedThrough: @0,
+    };
+  }
+  if (![stored isKindOfClass:[NSDictionary class]]) {
+    return nil;
+  }
+  NSDictionary *outbox = stored;
+  NSNumber *sequence = outbox[EXLocationCollectorOutboxSequence];
+  NSDictionary *pending = outbox[EXLocationCollectorOutboxPending];
+  NSNumber *acknowledgedThrough = outbox[EXLocationCollectorOutboxAcknowledgedThrough];
+  id terminalFailure = outbox[EXLocationCollectorOutboxTerminalFailure];
+  if (![sequence isKindOfClass:[NSNumber class]] ||
+      sequence.longLongValue < 0 ||
+      sequence.longLongValue > EXLocationCollectorMaxSafeInteger ||
+      ![pending isKindOfClass:[NSDictionary class]] ||
+      !EXLocationCollectorIsSafeInteger(acknowledgedThrough, YES) ||
+      acknowledgedThrough.longLongValue > sequence.longLongValue ||
+      (terminalFailure != nil &&
+       (![terminalFailure isKindOfClass:[NSString class]] || [terminalFailure length] == 0))) {
+    return nil;
+  }
+  if (pending.count > EXLocationCollectorMaxPendingBatches) {
+    return nil;
+  }
+  NSUInteger pendingEncodedBytes = 0;
+  long long maximumAccountedSequence = acknowledgedThrough.longLongValue;
+  NSMutableArray<NSArray<NSNumber *> *> *pendingSequenceRanges = [NSMutableArray new];
+  for (id batchId in pending) {
+    id batchValue = pending[batchId];
+    NSUUID *canonicalBatchId = [batchId isKindOfClass:[NSString class]]
+      ? [[NSUUID alloc] initWithUUIDString:batchId]
+      : nil;
+    if (![batchId isKindOfClass:[NSString class]] ||
+        canonicalBatchId == nil ||
+        ![canonicalBatchId.UUIDString.lowercaseString isEqualToString:batchId] ||
+        ![batchValue isKindOfClass:[NSDictionary class]]) {
+      return nil;
+    }
+    NSDictionary *batch = batchValue;
+    id batchGeneration = batch[@"collectorGeneration"];
+    id throughSequence = batch[@"collectorThroughSequence"];
+    NSArray *locations = batch[@"locations"];
+    if (![batch[@"collectorBatchId"] isEqual:batchId] ||
+        ![batchGeneration isEqual:generation] ||
+        !EXLocationCollectorIsSafeInteger(throughSequence, NO) ||
+        [throughSequence longLongValue] > sequence.longLongValue ||
+        ![locations isKindOfClass:[NSArray class]] ||
+        locations.count == 0 ||
+        locations.count > EXLocationCollectorMaxSamplesPerBatch) {
+      return nil;
+    }
+    long long firstSequence = [throughSequence longLongValue] - (long long)locations.count + 1;
+    if (firstSequence < 1) {
+      return nil;
+    }
+    [pendingSequenceRanges addObject:@[@(firstSequence), throughSequence]];
+    maximumAccountedSequence = MAX(maximumAccountedSequence, [throughSequence longLongValue]);
+    for (NSUInteger index = 0; index < locations.count; index++) {
+      id locationValue = locations[index];
+      if (![locationValue isKindOfClass:[NSDictionary class]]) {
+        return nil;
+      }
+      NSDictionary *location = locationValue;
+      id nativeSequence = location[@"nativeSequence"];
+      id coordsValue = location[@"coords"];
+      id timestamp = location[@"timestamp"];
+      if (!EXLocationCollectorIsSafeInteger(nativeSequence, NO) ||
+          [nativeSequence longLongValue] != firstSequence + (long long)index ||
+          ![coordsValue isKindOfClass:[NSDictionary class]] ||
+          !EXLocationCollectorIsFiniteNumber(timestamp) ||
+          [timestamp doubleValue] < 0) {
+        return nil;
+      }
+      NSDictionary *coords = coordsValue;
+      id latitude = coords[@"latitude"];
+      id longitude = coords[@"longitude"];
+      if (!EXLocationCollectorIsFiniteNumber(latitude) ||
+          [latitude doubleValue] < -90.0 || [latitude doubleValue] > 90.0 ||
+          !EXLocationCollectorIsFiniteNumber(longitude) ||
+          [longitude doubleValue] < -180.0 || [longitude doubleValue] > 180.0) {
+        return nil;
+      }
+    }
+    NSError *encodingError = nil;
+    NSData *encoded = [NSPropertyListSerialization dataWithPropertyList:batchValue
+                                                                 format:NSPropertyListBinaryFormat_v1_0
+                                                                options:0
+                                                                  error:&encodingError];
+    if (encoded == nil || encodingError != nil ||
+        encoded.length > EXLocationCollectorMaxEncodedBatchBytes ||
+        encoded.length > EXLocationCollectorMaxPendingEncodedBytes - pendingEncodedBytes) {
+      return nil;
+    }
+    pendingEncodedBytes += encoded.length;
+  }
+  NSArray<NSArray<NSNumber *> *> *orderedRanges = [pendingSequenceRanges sortedArrayUsingComparator:^NSComparisonResult(
+    NSArray<NSNumber *> *left,
+    NSArray<NSNumber *> *right
+  ) {
+    return [left[0] compare:right[0]];
+  }];
+  for (NSUInteger index = 1; index < orderedRanges.count; index++) {
+    if ([orderedRanges[index][0] longLongValue] <= [orderedRanges[index - 1][1] longLongValue]) {
+      return nil;
+    }
+  }
+  if (maximumAccountedSequence != sequence.longLongValue) {
+    return nil;
+  }
+  return outbox;
+}
+
+- (BOOL)persistCollectorOutbox:(NSDictionary *)outbox
+                           task:(id<EXTaskInterface>)task
+                     generation:(NSNumber *)generation
+{
+  if (![NSPropertyListSerialization propertyList:outbox isValidForFormat:NSPropertyListBinaryFormat_v1_0]) {
+    return NO;
+  }
+  NSUserDefaults *defaults = [NSUserDefaults standardUserDefaults];
+  [defaults setObject:outbox forKey:[EXLocationTaskConsumer outboxKeyForAppId:task.appId
+                                                                      taskName:task.name
+                                                                    generation:generation]];
+  return [defaults synchronize];
+}
+
+- (BOOL)persistTerminalFailureMessage:(NSString *)message
+                           usingOutbox:(NSDictionary *)outbox
+                                  task:(id<EXTaskInterface>)task
+                            generation:(NSNumber *)generation
+{
+  NSMutableDictionary *terminalOutbox = [outbox mutableCopy];
+  terminalOutbox[EXLocationCollectorOutboxTerminalFailure] = message;
+  if (![self persistCollectorOutbox:terminalOutbox task:task generation:generation]) {
+    return NO;
+  }
+  _collectorTerminalFailure = [self collectorError:message];
+  return YES;
+}
+
+- (BOOL)armDiscardOnlyRecoveryForTask:(id<EXTaskInterface>)task
+                           generation:(NSNumber *)generation
+                              message:(NSString *)message
+{
+  NSMutableDictionary *state = [[EXLocationTaskConsumer collectorStateForTaskName:task.name] mutableCopy];
+  if (![state[EXLocationCollectorStateActive] isEqualToNumber:generation]) {
+    return NO;
+  }
+  // Commit a state-level taint before deleting or replacing any malformed
+  // outbox bytes. The exact-generation outbox is removed only with the final
+  // discard-only proof after Core Location is stopped.
+  state[EXLocationCollectorStateRecoveryTainted] = @YES;
+  if (![EXLocationTaskConsumer persistCollectorState:state taskName:task.name]) {
+    return NO;
+  }
+
+  NSUserDefaults *defaults = [NSUserDefaults standardUserDefaults];
+  id rawOutbox = [defaults objectForKey:[EXLocationTaskConsumer outboxKeyForAppId:task.appId
+                                                                          taskName:task.name
+                                                                        generation:generation]];
+  id rawSequence = [rawOutbox isKindOfClass:[NSDictionary class]]
+    ? ((NSDictionary *)rawOutbox)[EXLocationCollectorOutboxSequence]
+    : nil;
+  _collectorSequence = EXLocationCollectorIsSafeInteger(rawSequence, YES)
+    ? [rawSequence longLongValue]
+    : 0;
+  _collectorTerminalFailure = [self collectorError:message];
+  _collectorDiscardCorruptOutbox = YES;
+  _collectorAcceptingEvents = NO;
+  return YES;
+}
+
+- (BOOL)cleanupOutboxAfterProof
+{
+  if (_task == nil || _collectorGeneration == nil) {
+    return NO;
+  }
+  NSUserDefaults *defaults = [NSUserDefaults standardUserDefaults];
+  [defaults removeObjectForKey:[EXLocationTaskConsumer outboxKeyForAppId:_task.appId
+                                                                 taskName:_task.name
+                                                               generation:_collectorGeneration]];
+  return [defaults synchronize];
+}
+
++ (NSDictionary *)collectorStateForTaskName:(NSString *)taskName
+{
+  id stored = [[NSUserDefaults standardUserDefaults] objectForKey:[self stateKeyForTaskName:taskName]];
+  return [stored isKindOfClass:[NSDictionary class]] ? stored : @{};
+}
+
++ (BOOL)persistCollectorState:(NSDictionary *)state taskName:(NSString *)taskName
+{
+  if (![NSPropertyListSerialization propertyList:state isValidForFormat:NSPropertyListBinaryFormat_v1_0]) {
+    return NO;
+  }
+  NSUserDefaults *defaults = [NSUserDefaults standardUserDefaults];
+  [defaults setObject:state forKey:[self stateKeyForTaskName:taskName]];
+  return [defaults synchronize];
+}
