+  private fun dispatchPersistedCollectorBatch(
+    batchId: String,
+    data: Bundle,
+    callback: TaskExecutionCallback = TaskExecutionCallback { _ -> }
+  ) {
+    val task = synchronized(collectorLock) {
+      if (!collectorDispatchedBatchIds.add(batchId)) return
+      mTask ?: run {
+        collectorDispatchedBatchIds.remove(batchId)
+        throw IllegalStateException("Location task is unavailable")
+      }
+    }
+    try {
+      task.execute(data, null) { response ->
+        val firstCompletion = synchronized(collectorLock) {
+          val removed = collectorDispatchedBatchIds.remove(batchId)
+          if (removed) {
+            maybeCompleteCollectorDrainLocked()
+          }
+          removed
+        }
+        if (firstCompletion) {
+          callback.onFinished(response)
+        }
+      }
+    } catch (error: Throwable) {
+      synchronized(collectorLock) { collectorDispatchedBatchIds.remove(batchId) }
+      throw error
+    }
+  }
