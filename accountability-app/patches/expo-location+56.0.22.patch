+      synchronized(collectorLock) {
+        val task = mTask ?: throw IllegalStateException("Location task is unavailable")
+        val generation = collectorGeneration
+          ?: throw IllegalStateException("Location collector generation is unavailable")
+        val preferences = context.getSharedPreferences(COLLECTOR_PREFERENCES, Context.MODE_PRIVATE)
+        pendingBatchIds(preferences, task.appScopeKey, task.name, generation)
+          .sorted()
+          .map { batchId ->
+            val encoded = preferences.getString(
+              batchDataKey(task.appScopeKey, task.name, generation, batchId),
+              null
+            ) ?: throw IllegalStateException("Persisted location collector batch is missing")
+            batchId to decodeBundle(encoded)
+          }
+      }
+    } catch (error: Throwable) {
+      failStopCollector(error)
+      return
+    }
+    for ((batchId, data) in batches) {
+      try {
+        dispatchPersistedCollectorBatch(batchId, data)
+      } catch (error: Throwable) {
+        failStopCollector(error)
+        return
+      }
+    }
+  }
