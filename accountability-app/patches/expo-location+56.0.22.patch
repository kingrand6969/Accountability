+  private fun failStopCollector(error: Throwable) {
+    synchronized(collectorLock) {
+      val task = mTask
+      val generation = collectorGeneration
+      if (task != null && generation != null) {
+        val preferences = context.getSharedPreferences(COLLECTOR_PREFERENCES, Context.MODE_PRIVATE)
+        val key = terminalFailureKey(task.appScopeKey, task.name, generation)
+        if (!preferences.contains(key) && !preferences.edit().putString(key, error.message ?: "Location collector terminal failure").commit()) {
+          failCollectorLocked(IllegalStateException("Location collector terminal failure could not be persisted"))
+        }
+      }
+      if (collectorTerminalFailure == null) collectorTerminalFailure = error
+      collectorAcceptingEvents = false
+    }
