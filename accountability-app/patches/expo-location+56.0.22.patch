+          throw persistCollectorCapacityFailure(
+            preferences,
+            task,
+            generation,
+            "Location collector pending outbox exceeds its durable byte budget"
+          )
+        }
+        pendingEncodedBytes += encodedBatch.length.toLong()
+        if (!pending.add(batchId)) {
+          throw IllegalStateException("Location collector batch ID was reused")
+        }
