+  private fun acknowledgePersistedCollectorBatch(
+    expectedGeneration: Long,
+    batchId: String,
+    expectedThroughSequence: Long,
+    taintGeneration: Boolean
+  ) {
+    synchronized(collectorLock) {
+      if (collectorGeneration != expectedGeneration) {
+        throw IllegalStateException("Location collector generation does not match")
+      }
+      val task = mTask ?: throw IllegalStateException("Location task is unavailable")
+      persistedDrainOutcome(
+        context,
+        task.appScopeKey,
+        task.name,
+        expectedGeneration
+      )?.let { proof ->
+        if (
+          expectedThroughSequence <= proof.throughSequence &&
+          (!taintGeneration || proof.tainted)
+        ) return
+        throw IllegalStateException("Location collector acknowledgement exceeds its drain proof")
+      }
+      val preferences = context.getSharedPreferences(COLLECTOR_PREFERENCES, Context.MODE_PRIVATE)
+      val ackThroughKey = acknowledgementThroughKey(
+        task.appScopeKey,
+        task.name,
+        expectedGeneration
+      )
+      val acknowledgedThrough = preferences.getLong(ackThroughKey, 0L)
+      if (acknowledgedThrough < 0L || acknowledgedThrough > collectorSequence) {
+        throw IllegalStateException("Location collector acknowledgement high-water is corrupt")
+      }
+      val dataKey = batchDataKey(task.appScopeKey, task.name, expectedGeneration, batchId)
+      val encoded = preferences.getString(dataKey, null)
+      if (encoded == null) {
+        if (
+          expectedThroughSequence <= acknowledgedThrough &&
+          (!taintGeneration || preferences.contains(
+            terminalFailureKey(task.appScopeKey, task.name, expectedGeneration)
+          ))
+        ) return
+        throw IllegalStateException("Location collector batch is not pending")
+      }
+      val data = decodeBundle(encoded)
+      val generation = data.getDouble("collectorGeneration", Double.NaN)
+      val throughSequence = data.getDouble("collectorThroughSequence", Double.NaN)
+      if (
+        generation != expectedGeneration.toDouble() ||
+        data.getString("collectorBatchId") != batchId ||
+        throughSequence != expectedThroughSequence.toDouble()
+      ) {
+        throw IllegalStateException("Location collector acknowledgement does not match its batch")
+      }
+      val pending = pendingBatchIds(
+        preferences,
+        task.appScopeKey,
+        task.name,
+        expectedGeneration
+      )
+      if (!pending.remove(batchId)) {
+        throw IllegalStateException("Location collector batch is not indexed as pending")
+      }
+      val editor = preferences.edit()
+        .remove(dataKey)
+        .putStringSet(
+          pendingIndexKey(task.appScopeKey, task.name, expectedGeneration),
+          pending
+        )
+        .putLong(ackThroughKey, maxOf(acknowledgedThrough, expectedThroughSequence))
+      if (taintGeneration) {
+        editor.putString(
+          terminalFailureKey(task.appScopeKey, task.name, expectedGeneration),
+          COLLECTOR_JS_DISCARD_MESSAGE
+        )
+      }
+      val committed = editor.commit()
+      if (!committed) {
+        throw IllegalStateException("Location collector acknowledgement could not be persisted")
+      }
+      if (taintGeneration) {
+        collectorTerminalFailure = IllegalStateException(COLLECTOR_JS_DISCARD_MESSAGE)
+        collectorAcceptingEvents = false
+      }
+      maybeCompleteCollectorDrainLocked()
+    }
+  }
