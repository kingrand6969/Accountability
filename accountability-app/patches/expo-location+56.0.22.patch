++ (NSString *)outboxKeyForAppId:(NSString *)appId
+                        taskName:(NSString *)taskName
+                      generation:(NSNumber *)generation
+{
+  return [NSString stringWithFormat:@"%@.outbox:%@:%@:%@", EXLocationCollectorPreferences, appId, taskName, generation];
+}
+
+- (nullable NSNumber *)validGeneration:(nullable id)value
+{
+  if (value == nil || [value isEqual:[NSNull null]]) {
+    return nil;
+  }
+  if (![value isKindOfClass:[NSNumber class]]) {
+    @throw [NSException exceptionWithName:@"E_LOCATION_COLLECTOR_GENERATION"
+                                   reason:@"Location collector generation must be numeric"
+                                 userInfo:nil];
+  }
+  NSNumber *number = (NSNumber *)value;
+  double generation = number.doubleValue;
+  long long exact = number.longLongValue;
+  if (!isfinite(generation) || generation < 1 || generation > EXLocationCollectorMaxSafeInteger || generation != (double)exact) {
+    @throw [NSException exceptionWithName:@"E_LOCATION_COLLECTOR_GENERATION"
+                                   reason:@"Location collector generation must be a positive safe integer"
+                                 userInfo:nil];
+  }
+  return @(exact);
+}
