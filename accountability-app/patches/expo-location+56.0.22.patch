+        val pendingBatch = preferences.getString(
+          batchDataKey(task.appScopeKey, task.name, generation, pendingBatchId),
+          null
+        ) ?: throw IllegalStateException("Persisted location collector batch is missing")
+        if (pendingBatch.length > MAX_COLLECTOR_ENCODED_BATCH_BYTES) {
+          throw IllegalStateException("Persisted location collector batch exceeds the durable bridge limit")
+        }
+        pendingEncodedBytes += pendingBatch.length.toLong()
+        if (pendingEncodedBytes > MAX_COLLECTOR_PENDING_ENCODED_BYTES) {
+          throw persistCollectorCapacityFailure(
+            preferences,
+            task,
+            generation,
+            "Location collector pending outbox exceeds its durable byte budget"
+          )
+        }
+      }
+      val incomingBatchCount =
+        (locationBundles.size + MAX_COLLECTOR_SAMPLES_PER_BATCH - 1) /
+          MAX_COLLECTOR_SAMPLES_PER_BATCH
+      if (
+        pending.size > MAX_COLLECTOR_PENDING_BATCHES ||
+        incomingBatchCount > MAX_COLLECTOR_PENDING_BATCHES - pending.size
+      ) {
+        throw persistCollectorCapacityFailure(
+          preferences,
+          task,
+          generation,
+          "Location collector pending outbox exceeds its durable batch budget"
+        )
+      }
+      val persisted = mutableListOf<Pair<String, Bundle>>()
+      val encoded = mutableListOf<Pair<String, String>>()
+      var nextSequence = collectorSequence
+      for (chunk in locationBundles.chunked(MAX_COLLECTOR_SAMPLES_PER_BATCH)) {
+        val exactLocations = ArrayList(chunk)
+        for (locationBundle in exactLocations) {
+          if (nextSequence >= MAX_SAFE_INTEGER) {
+            throw IllegalStateException("Location collector sequence is exhausted")
+          }
+          nextSequence += 1L
+          locationBundle.putDouble("nativeSequence", nextSequence.toDouble())
+        }
