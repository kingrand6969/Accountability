+  private fun maybeCompleteCollectorDrainLocked() {
+    val drain = collectorDrain ?: return
+    if (drain.isCompleted) return
+    collectorFailure?.let {
+      drain.completeExceptionally(it)
+      return
+    }
+    if (
+      !collectorSourceDrained ||
+      collectorAcceptingEvents ||
+      collectorNativeCallbacksInFlight != 0 ||
+      collectorDispatchedBatchIds.isNotEmpty()
+    ) {
+      return
+    }
+    val task = mTask ?: run {
+      drain.completeExceptionally(IllegalStateException("Location task disappeared before drain proof"))
+      return
+    }
+    val generation = collectorGeneration ?: run {
+      drain.completeExceptionally(IllegalStateException("Location collector generation disappeared before drain proof"))
+      return
+    }
+    val preferences = context.getSharedPreferences(COLLECTOR_PREFERENCES, Context.MODE_PRIVATE)
+    if (collectorDiscardCorruptOutbox) {
+      if (!completeDiscardOnlyRecoveryLocked(task, generation, preferences)) {
+        drain.completeExceptionally(IllegalStateException("Discard-only location drain proof could not be persisted"))
+        return
+      }
+      collectorDiscardCorruptOutbox = false
+      drain.complete(collectorSequence)
+      return
+    }
+    try {
+      validateRestoredCollectorOutbox(task, generation)
+    } catch (error: Throwable) {
+      armRestoredOutboxDiscardOnly(task, generation, error)
+      return
+    }
+    if (pendingBatchIds(preferences, task.appScopeKey, task.name, generation).isNotEmpty()) {
+      return
+    }
+    val committed = synchronized(sCollectorClaimsLock) {
+      val activeKey = activeGenerationKey(task.appScopeKey, task.name)
+      if (preferences.getLong(activeKey, 0L) != generation) {
+        false
+      } else {
+        val tainted = collectorTerminalFailure != null ||
+          preferences.contains(terminalFailureKey(task.appScopeKey, task.name, generation))
+        val exactBatchPrefix = exactBatchDataPrefix(task.appScopeKey, task.name, generation)
+        val exactBatchKeys = preferences.all.keys.filter { it.startsWith(exactBatchPrefix) }
+        val editor = preferences.edit()
+          .putLong(drainProofGenerationKey(task.appScopeKey, task.name), generation)
+          .putLong(drainProofThroughSequenceKey(task.appScopeKey, task.name), collectorSequence)
+          .putBoolean(drainProofTaintedKey(task.appScopeKey, task.name), tainted)
+          .remove(activeKey)
+          .remove(collectorPhaseKey(task.appScopeKey, task.name))
+          .remove(terminalFailureKey(task.appScopeKey, task.name, generation))
+          .remove(sequenceKey(task.appScopeKey, task.name, generation))
+          .remove(pendingIndexKey(task.appScopeKey, task.name, generation))
+          .remove(acknowledgementThroughKey(task.appScopeKey, task.name, generation))
+        for (batchKey in exactBatchKeys) {
+          editor.remove(batchKey)
+        }
+        editor.commit()
+      }
+    }
+    if (!committed) {
+      drain.completeExceptionally(IllegalStateException("Location drain proof could not be persisted"))
+      return
+    }
+    drain.complete(collectorSequence)
+  }
