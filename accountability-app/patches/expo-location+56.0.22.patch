++ (NSError *)staticCollectorError:(NSString *)message
+{
+  return [NSError errorWithDomain:@"ExpoLocationCollectorDrain"
+                             code:1
+                         userInfo:@{ NSLocalizedDescriptionKey: message }];
+}
