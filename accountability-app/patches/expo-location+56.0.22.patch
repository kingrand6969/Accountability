+    return;
+  }
+  if (_collectorFailure != nil) {
+    NSArray *completions = [_collectorDrainCompletions copy];
+    [_collectorDrainCompletions removeAllObjects];
+    for (void (^completion)(NSNumber *, NSError *) in completions) {
+      completion(nil, _collectorFailure);
+    }
+    return;
