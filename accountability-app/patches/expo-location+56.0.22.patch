+  NSString *taskName = _task.name;
+  NSString *appId = _task.appId;
+  if (taskName == nil || appId == nil || _collectorGeneration == nil) {
+    _collectorFailure = [self collectorError:@"Location task disappeared before drain proof"];
+    [self maybeCompleteCollectorDrain];
+    return;
+  }
+  @synchronized([EXLocationTaskConsumer class]) {
+    NSMutableDictionary *state = [[EXLocationTaskConsumer collectorStateForTaskName:taskName] mutableCopy];
+    if (![state[EXLocationCollectorStateActive] isEqualToNumber:_collectorGeneration]) {
+      _collectorFailure = [self collectorError:@"Location collector generation claim is unconfirmed"];
+      [self maybeCompleteCollectorDrain];
+      return;
+    }
+    [state removeObjectForKey:EXLocationCollectorStateActive];
+    [state removeObjectForKey:EXLocationCollectorStatePhase];
+    [state removeObjectForKey:EXLocationCollectorStateAppId];
+    [state removeObjectForKey:EXLocationCollectorStateRecoveryTainted];
+    state[EXLocationCollectorStateDrainGeneration] = _collectorGeneration;
+    state[EXLocationCollectorStateDrainThrough] = @(_collectorSequence);
