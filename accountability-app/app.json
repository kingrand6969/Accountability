{
  "expo": {
    "name": "AccountAbility",
    "slug": "accountability-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "accountabilityapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.awldesk.accountability",
      "supportsTablet": true,
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "UIBackgroundModes": [
          "location"
        ]
      }
    },
    "android": {
      "package": "com.awldesk.accountability",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFC",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFC",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 140
          }
        }
      ],
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "locationAlwaysAndWhenInUsePermission": "Accountability App uses your location to track your runs, rides and walks — even with the screen off.",
          "locationWhenInUsePermission": "Accountability App uses your location to track your runs, rides and walks."
        }
      ],
      "expo-notifications",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "cameraPermission": "AccountAbility uses your camera for selfies, run cards, stories and profile photos.",
          "photosPermission": "AccountAbility needs photo access to add pictures to posts, run cards and Memories."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
