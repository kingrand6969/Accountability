{
  "expo": {
    "name": "Mantle",
    "slug": "accountability-app",
    "version": "1.0.1",
    "orientation": "portrait",
    "backgroundColor": "#0B0D0B",
    "icon": "./assets/images/icon.png",
    "scheme": "accountabilityapp",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.awldesk.accountability",
      "supportsTablet": true,
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "NSCameraUsageDescription": "Mantle uses the front camera for a private on-device beauty preview.",
        "UIBackgroundModes": [
          "location"
        ]
      }
    },
    "android": {
      "package": "com.awldesk.accountability",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#0B0D0B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0D0B",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 140
          }
        }
      ],
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "locationAlwaysAndWhenInUsePermission": "Mantle uses your location to track your runs, rides and walks — even with the screen off.",
          "locationWhenInUsePermission": "Mantle uses your location to track your runs, rides and walks."
        }
      ],
      "expo-notifications",
      "expo-sharing",
      "expo-video",
      [
        "expo-audio",
        {
          "microphonePermission": "Mantle uses your microphone only when you choose to record a voice Cheer.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Mantle uses your camera for selfies, run cards, stories and profile photos.",
          "microphonePermission": false,
          "photosPermission": "Mantle needs photo and video access when you choose media for a post, run card or Memory."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Mantle needs photo access to add pictures to posts, run cards and Memories.",
          "savePhotosPermission": "Mantle needs permission to save photos and videos to your media library.",
          "granularPermissions": [
            "photo",
            "video"
          ]
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f91c0791-4a6e-4080-88fd-5cc9a4e720bf"
      }
    },
    "owner": "kingrand",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f91c0791-4a6e-4080-88fd-5cc9a4e720bf",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
