{
  "expo": {
    "name": "AccountAbility",
    "slug": "accountability-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "accountabilityapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.awldesk.accountability",
      "supportsTablet": true,
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSCameraUsageDescription": "AccountAbility uses the front camera for a private on-device beauty preview.",
        "UIBackgroundModes": [
          "location"
        ]
      }
    },
    "android": {
      "package": "com.awldesk.accountability",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFC",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFC",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 140
          }
        }
      ],
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "locationAlwaysAndWhenInUsePermission": "Accountability App uses your location to track your runs, rides and walks — even with the screen off.",
          "locationWhenInUsePermission": "Accountability App uses your location to track your runs, rides and walks."
        }
      ],
      "expo-notifications",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "cameraPermission": "AccountAbility uses your camera for selfies, run cards, stories and profile photos.",
          "microphonePermission": false,
          "photosPermission": "AccountAbility needs photo access to add pictures to posts, run cards and Memories."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "AccountAbility needs photo access to add pictures to posts, run cards and Memories.",
          "savePhotosPermission": "AccountAbility needs permission to save photos and videos to your media library.",
          "granularPermissions": [
            "photo",
            "video"
          ]
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f91c0791-4a6e-4080-88fd-5cc9a4e720bf"
      }
    },
    "owner": "kingrand",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f91c0791-4a6e-4080-88fd-5cc9a4e720bf"
    }
  }
}
